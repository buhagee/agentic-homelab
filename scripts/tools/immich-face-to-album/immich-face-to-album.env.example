# Immich Face-to-Album Configuration
# Copy to immich-face-to-album.env and fill in values

# Immich server URL (shared)
IMMICH_SERVER_URL=https://photos.example.com

# API key for Justin's account
# Generate at: Immich web UI → Account Settings → API Keys (logged in as Justin)
# Required scopes: Asset:Read, Album:Read, Album:Update
IMMICH_API_KEY_JUSTIN="<justin-api-key>"

# API key for Annique's account
# Generate at: Immich web UI → Account Settings → API Keys (logged in as Annique)
# Required scopes: Asset:Read, Album:Read, Album:Update
IMMICH_API_KEY_ANNIQUE="<annique-api-key>"
