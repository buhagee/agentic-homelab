# Immich Bulk Upload Configuration
# Copy this file to immich-bulk-upload.env and fill in your values
# This file contains sensitive API keys - do not commit to git

# Immich server URL
# Using localhost to bypass Traefik for large file uploads (10GB+ videos)
IMMICH_SERVER_URL=http://localhost:2283

# Immich API key for the target user account
# Generate at: Immich web UI → Account Settings → API Keys
IMMICH_API_KEY=your-api-key-here

# User email (for reference/logging only)
IMMICH_USER_EMAIL=your-email@example.com

# Source drive device (e.g., /dev/sde1)
SOURCE_DEVICE=/dev/sde1

# Mount point for the source drive
SOURCE_MOUNT_PATH=/mnt/elements

# ============================================
# Upload Configuration (Optional)
# ============================================

# Parallel upload threads (1-20, default: 8)
# Higher = faster but more resource intensive
CONCURRENT_TASKS=8

# Album creation from folder structure
# Options: FOLDER (folder name), PATH (full path), NONE (no albums)
FOLDER_AS_ALBUM=FOLDER

# Use folder structure as tags (true/false)
FOLDER_AS_TAGS=false

# Error handling: stop, continue, or number (e.g., 10 = stop after 10 errors)
ON_ERRORS=continue

# Server call timeout (e.g., 30m, 1h, 120m)
CLIENT_TIMEOUT=30m

# Pause Immich server jobs during upload (true/false)
# Recommended for large uploads to improve performance
PAUSE_IMMICH_JOBS=true

# ============================================
# Batch Mode Configuration (Optional)
# ============================================

# Number of folders to process per batch (batch mode only)
BATCH_SIZE=20

# Seconds to wait between batches (optional)
# BATCH_DELAY=5

# ============================================
# Advanced Options (Optional)
# ============================================

# Tag uploads with session timestamp (optional)
# SESSION_TAG=true

# Add custom tag to all uploads (optional)
# CUSTOM_TAG="External Drive Upload"

# Handle burst photos: Stack (optional)
# MANAGE_BURST=Stack

# Handle RAW+JPEG pairs: StackCoverRaw (optional)
# MANAGE_RAW_JPEG=StackCoverRaw
