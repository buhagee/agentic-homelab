# =============================================================================
# versions.env — Qacey Platform Image Version Registry
# =============================================================================
# This file is the SINGLE SOURCE OF TRUTH for all Docker image versions used
# across the Qacey Platform.
#
# RULES:
#   - When adding a new service, add its version here first.
#   - Never hardcode a version tag in docker-compose.platform.yml or a
#     Dockerfile base image — always reference a variable from this file.
#   - After updating a version here, run: bash scripts/build.sh
#
# LOADED BY: scripts/start.sh, stop.sh, build.sh, reset.sh, first-time-setup.sh
#            (passed as --env-file versions.env to docker compose)
# =============================================================================

# ── Infrastructure ────────────────────────────────────────────────────────────

# Traefik — reverse proxy and TLS termination
# Releases: https://github.com/traefik/traefik/releases
# Tags:     https://hub.docker.com/_/traefik/tags
# renovate: datasource=docker depName=TRAEFIK_VERSION packageName=traefik versioning=docker
TRAEFIK_VERSION=v3.8.0

# Cloudflared — Cloudflare Tunnel daemon
# Releases: https://github.com/cloudflare/cloudflared/releases
# Tags:     https://hub.docker.com/r/cloudflare/cloudflared/tags
# NOTE (U-11): cloudflared is kept as fallback during WireGuard migration.
# Remove after WireGuard tunnel is verified stable.
# renovate: datasource=docker depName=CLOUDFLARED_VERSION packageName=cloudflare/cloudflared versioning=docker
CLOUDFLARED_VERSION=2026.11.2

# WireGuard — VPN tunnel (linuxserver/wireguard)
# Used for Oracle VPS ↔ home server tunnel (bypasses Cloudflare 100MB limit)
# Releases: https://github.com/linuxserver/docker-wireguard/releases
# Tags:     https://hub.docker.com/r/linuxserver/wireguard/tags
# renovate: datasource=docker depName=WIREGUARD_VERSION packageName=lscr.io/linuxserver/wireguard versioning=docker
WIREGUARD_VERSION=1.0.20260223-r0-ls125

# AdGuard Home — local DNS server (split-horizon DNS for *.example.com)
# Releases: https://github.com/AdguardTeam/AdGuardHome/releases
# Tags:     https://hub.docker.com/r/adguard/adguardhome/tags
# renovate: datasource=docker depName=ADGUARD_VERSION packageName=adguard/adguardhome versioning=docker
ADGUARD_VERSION=v1.0.0

# Ollama — local model API
# Releases: https://github.com/ollama/ollama/releases
# Tags:     https://hub.docker.com/r/ollama/ollama/tags
# renovate: datasource=docker depName=OLLAMA_VERSION packageName=ollama/ollama versioning=docker
OLLAMA_VERSION=0.40.18

# CrowdSec — behavioral IDS engine
# Releases: https://github.com/crowdsecurity/crowdsec/releases
# Tags:     https://hub.docker.com/r/crowdsecurity/crowdsec/tags
# renovate: datasource=docker depName=CROWDSEC_VERSION packageName=crowdsecurity/crowdsec versioning=docker
CROWDSEC_VERSION=v1.8.2

# CrowdSec Traefik Bouncer Plugin — maxlerebourg/crowdsec-bouncer-traefik-plugin
# Runs inside Traefik process (no separate container). Handles IP banning + AppSec WAF.
# Replaces fbonalair/traefik-crowdsec-bouncer (removed in U-12).
# Releases: https://github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin/releases
# NOTE: reference only. The repo's U-12 rework removed the experimental.plugins
# declaration from traefik.yml; plugin wiring now lives in
# infrastructure/traefik/config/dynamic/middlewares.yml (plugin.bouncer).

# oauth2-proxy — Google SSO for the native development gateway
# Releases: https://github.com/oauth2-proxy/oauth2-proxy/releases
# renovate: datasource=docker depName=OAUTH2_PROXY_VERSION packageName=quay.io/oauth2-proxy/oauth2-proxy versioning=docker
OAUTH2_PROXY_VERSION=v7.15.6

# Caddy — private Unix-socket adapter for the opt-in native development gateway
# renovate: datasource=docker depName=CADDY_VERSION packageName=caddy versioning=docker
CADDY_VERSION=2.11.9-alpine

# ── Immich ────────────────────────────────────────────────────────────────────

# Immich — self-hosted photo and video backup
# Releases:     https://github.com/immich-app/immich/releases
# Tags:         ghcr.io/immich-app/immich-server
# IMPORTANT:    immich-server and immich-machine-learning must always match.
# renovate: datasource=docker depName=IMMICH_VERSION packageName=ghcr.io/immich-app/immich-server versioning=docker
IMMICH_VERSION=v3.4.2

# Immich Postgres — official VectorChord image. The live database was verified
# to use vchord indexes, so the temporary pgvecto.rs compatibility layer is
# no longer required.
# Tags:         ghcr.io/immich-app/postgres
IMMICH_POSTGRES_VERSION=14-vectorchord1.1.1@sha256:a363c71004f469d61b049703935da4725f90db793ba2efa7e451e6313f0e8dac

# ── Vaultwarden ───────────────────────────────────────────────────────────────

# Vaultwarden — self-hosted Bitwarden-compatible password manager
# Releases: https://github.com/dani-garcia/vaultwarden/releases
# Tags:     https://hub.docker.com/r/vaultwarden/server/tags
# renovate: datasource=docker depName=VAULTWARDEN_VERSION packageName=vaultwarden/server versioning=docker
VAULTWARDEN_VERSION=1.37.5

# ── SearXNG ───────────────────────────────────────────────────────────────────

# SearXNG — self-hosted meta search engine (internal, no subdomain)
# Pin the tested date/hash tag; do not follow 'latest' implicitly.
# Releases: https://github.com/searxng/searxng/releases
# Tags:     https://hub.docker.com/r/searxng/searxng/tags
# renovate: datasource=docker depName=SEARXNG_VERSION packageName=searxng/searxng versioning=loose
SEARXNG_VERSION=2026.11.26-b5605b8f2

# ── Home Assistant ────────────────────────────────────────────────────────────

# Home Assistant — home automation platform
# Releases: https://github.com/home-assistant/core/releases
# Tags:     ghcr.io/home-assistant/home-assistant
# NOTE:     Pin to year.month (e.g. 2026.5) for auto-patch within a month,
#           or use specific patch (e.g. 2026.5.1) to fully lock.
# renovate: datasource=docker depName=HOMEASSISTANT_VERSION packageName=ghcr.io/home-assistant/home-assistant versioning=docker
HOMEASSISTANT_VERSION=2026.11.3

# ── Shared Infrastructure ─────────────────────────────────────────────────────

# PostgreSQL — Paperless database
# Tags: https://hub.docker.com/_/postgres/tags
# renovate: datasource=docker depName=POSTGRES_VERSION packageName=postgres versioning=docker
POSTGRES_VERSION=15.20@sha256:10f9e886f772e9d6484350b043bcf990ead67ae5d9988ddce265d72a299055d5

# Redis — in-memory cache (used by Immich)
# Tags: https://hub.docker.com/_/redis/tags
# renovate: datasource=docker depName=REDIS_VERSION packageName=redis versioning=docker
REDIS_VERSION=8-alpine@sha256:7958cfbb9d152f87dadfbc89f1b0b15938f0b81ff8982feb327476f4911935c3

# ── MCP Containers ────────────────────────────────────────────────────────────

# SearXNG MCP — upstream Streamable HTTP server (linux/amd64 manifest)
# Release: https://github.com/ihor-sokoliuk/mcp-searxng/releases
# Image:   https://hub.docker.com/r/isokoliuk/mcp-searxng
# v2.x keeps the SEARXNG_URL / MCP_HTTP_PORT / MCP_HTTP_HOST env contract.
# The tag and architecture-specific digest are retained deliberately; update
# both only after verifying the upstream registry manifest.
MCP_SEARXNG_IMAGE=isokoliuk/mcp-searxng:2.5.1@sha256:42818a61c24206632a93ccbf8d8374fb2cf9c7f3ddec8c669c82e69c9e0fbffc

# Crawl4AI — web scraping engine (used by mcp-crawl4ai)
# Releases: https://github.com/unclecode/crawl4ai/releases
# Tags:     https://hub.docker.com/r/unclecode/crawl4ai/tags
# renovate: datasource=docker depName=CRAWL4AI_VERSION packageName=unclecode/crawl4ai versioning=docker
CRAWL4AI_VERSION=0.9.6

# ── Platform additions (new services) ───────────────────────────────────────
# When adding a new service, add its version here first and update
# `docker-compose.platform.yml` to reference the variable (do NOT hardcode).
# renovate: datasource=docker depName=PAPERLESS_VERSION packageName=ghcr.io/paperless-ngx/paperless-ngx versioning=docker
PAPERLESS_VERSION=3.5.1

# =============================================================================
# Dockerfile base images — these cannot be injected via env vars.
# Update them directly in the Dockerfile, then record them here for reference.
# =============================================================================

# services/mcp/*/Dockerfile          FROM python:3.13-slim
#   Tags: https://hub.docker.com/_/python/tags

# ── U-14: Drive health monitoring ────────────────────────────────────────────
# renovate: datasource=docker depName=SCRUTINY_VERSION packageName=ghcr.io/analogj/scrutiny versioning=docker
SCRUTINY_VERSION=v0.10.0-omnibus
#   Releases: https://github.com/AnalogJ/scrutiny/pkgs/container/scrutiny
