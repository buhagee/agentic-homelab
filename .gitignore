# ── Secrets & environment ─────────────────────────────────────────────────
*.env
!/versions.env
scripts/tools/immich-bulk-upload/immich-bulk-upload.env
scripts/tools/immich-face-to-album/immich-face-to-album.env
scripts/tools/immich-face-to-album/immich-face-to-album.conf
.env.local
.env.*.local
.env.oracle
.env.bak

# ── TLS certificates ──────────────────────────────────────────────────────
infrastructure/traefik/certs/
*.pem
*.key
*.crt
acme.json

# ── Zitadel machine key (added in U-02) ──────────────────────────────────
infrastructure/zitadel/machinekey/
*.pat

# ── Initialisation sentinel ───────────────────────────────────────────────
.qacey-initialized

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Backup files ─────────────────────────────────────────────────────────
*.bak
*.backup
.worktrees/
infrastructure/certs/
scripts/immich-bulk-upload.env

# Temporary agent plans, design drafts and review notes
/.superpowers/
/docs/superpowers/

# Rendered from .tmpl with secrets/.env
