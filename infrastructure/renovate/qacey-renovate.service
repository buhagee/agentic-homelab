[Unit]
Description=Trigger the Qacey Renovate workflow
Documentation=https://github.com/buhagee/qacey_platform
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=buhagiar
ExecStart=/bin/bash __PLATFORM_DIR__/scripts/maintenance/trigger-renovate.sh
StandardOutput=journal
StandardError=journal
