{
  "model": "openai/gpt-6.2-sol",
  "plugins": [
    "open-codebase-index@0.39.0",
    "-opencode.provider.openai-context-caps"
  ],
  "instructions": [
    "{env:HOME}/.config/opencode/instructions/subagent-model-policy.md",
    "{env:HOME}/.config/opencode/instructions/caveman-default.md"
  ],
  "agents": {
    "build": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/implementation-research.txt}"
    },
    "general": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/implementation-research.txt}"
    },
    "explore": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/implementation-research.txt}"
    },
    "plan": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/planning-review.txt}"
    },
    "compaction": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/implementation-research.txt}"
    },
    "title": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/implementation-research.txt}"
    },
    "summary": {
      "model": "{file:/home/opencode/.config/opencode/model-pins/implementation-research.txt}"
    },
    "planner": {
      "description": "Read-only planning and design analysis",
      "mode": "subagent",
      "model": "{file:/home/opencode/.config/opencode/model-pins/planning-review.txt}",
      "system": "You are a read-only planning subagent. Analyze the request, inspect relevant files, identify constraints, risks, and a concrete plan. Do not edit files, run shell commands, launch subagents, or mutate external systems. Return findings and the recommended approach to the primary agent.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "reviewer": {
      "description": "Independent read-only code and spec reviewer",
      "mode": "subagent",
      "model": "{file:/home/opencode/.config/opencode/model-pins/planning-review.txt}",
      "system": "You are an independent reviewer. Inspect the provided changes, requirements, and evidence. Report concrete findings in severity order with file and line references, reproduction where possible, strengths, and an assessment. Do not edit files, run shell commands, launch subagents, or mutate external systems. Read-only MCP tools may be used; never call mutating tools.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "crawl4ai": {
        "type": "remote",
        "url": "http://mcp-crawl4ai:8000/mcp"
      },
      "searxng": {
        "type": "remote",
        "url": "http://mcp-searxng:3000/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "academic-papers": {
        "type": "remote",
        "url": "http://mcp-academic-papers:8000/mcp"
      },
      "qacey-docker-control": {
        "type": "remote",
        "url": "http://opencode-docker-control:8000/mcp",
        "oauth": false,
        "codemode": false
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "**/.env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/secrets/**",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/secrets/**",
      "effect": "deny"
    },
    {
      "action": "qacey-docker-control_manage_service",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "gstack-ship",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-land-and-deploy",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-setup-deploy",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-autoplan",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-captain",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-upgrade",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-setup-gbrain",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-sync-gbrain",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-browse",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-qa",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-codex",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "gstack-claude-code",
      "effect": "deny"
    }
  ]
}
