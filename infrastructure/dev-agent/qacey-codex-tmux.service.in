[Unit]
Description=Qacey persistent native Codex terminal sessions
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=~
RuntimeDirectory=qacey-codex-tmux
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/tmux -D -f /dev/null -S /run/qacey-codex-tmux/server.sock
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
