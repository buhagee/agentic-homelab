provider = "oidc"
oidc_issuer_url = @ISSUER@
client_id = @CLIENT_ID@
redirect_url = "https://@HOSTNAME@/oauth2/callback"
http_address = "0.0.0.0:4180"
upstreams = ["http://adapter:8080/"]
authenticated_emails_file = "/etc/oauth2-proxy/allowed-emails.txt"
scope = "openid email profile"
code_challenge_method = "S256"
insecure_oidc_allow_unverified_email = false
insecure_oidc_skip_issuer_verification = false
insecure_oidc_skip_nonce = false
cookie_name = "__Host-qacey-dev"
cookie_path = "/"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_expire = "2h"
cookie_refresh = "30m"
cookie_csrf_per_request = true
reverse_proxy = true
proxy_websockets = true
pass_host_header = true
pass_basic_auth = false
pass_authorization_header = false
set_authorization_header = false
pass_access_token = false
pass_user_headers = true
skip_auth_strip_headers = true
skip_provider_button = true
request_logging = false
flush_interval = "1ms"
