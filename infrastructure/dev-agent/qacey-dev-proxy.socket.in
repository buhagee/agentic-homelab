[Unit]
Description=Private Unix bridge for the authenticated development gateway

# This socket follows a normal service, after basic.target, rather than early sockets.target.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target qacey-openchamber.service
BindsTo=qacey-openchamber.service
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ListenStream=/run/qacey-dev-proxy/backend.sock
SocketUser=@USER@
SocketGroup=@USER@
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=multi-user.target
