[Unit]
Description=Qacey native OpenChamber development interface
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=~
EnvironmentFile=/etc/qacey-dev/openchamber.env
ExecStart=/usr/local/bin/qacey-dev openchamber
UMask=0077
# The foreground CLI exits numerically with 128 + SIGTERM on graceful shutdown.
SuccessExitStatus=143
Restart=on-failure
RestartSec=15s
MemoryAccounting=true
MemoryHigh=8G
MemoryMax=12G
MemorySwapMax=2G
OOMPolicy=kill
TimeoutStopSec=45s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
