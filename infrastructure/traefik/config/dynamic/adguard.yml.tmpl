http:
  routers:
    adguard:
      rule: "Host(`adguard.__QACEY_DOMAIN__`)"
      entryPoints:
        - websecure
      tls:
        certResolver: cloudflare
      middlewares:
        - secure-headers@file
      service: adguard

    adguard-cf:
      rule: "Host(`adguard.__QACEY_DOMAIN__`)"
      entryPoints:
        - cloudflared
      middlewares:
        - secure-headers@file
      service: adguard

  services:
    adguard:
      loadBalancer:
        servers:
          - url: "http://host.docker.internal:3000"
