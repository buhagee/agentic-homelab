http:
  routers:
    homeassistant:
      rule: "Host(`ha.__QACEY_DOMAIN__`)"
      entryPoints:
        - websecure
        - cloudflared
      tls:
        certResolver: cloudflare
      middlewares:
        - secure-headers@file
      service: homeassistant

  services:
    homeassistant:
      loadBalancer:
        servers:
          - url: "http://host-gateway:8123"
