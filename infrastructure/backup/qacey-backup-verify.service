[Unit]
Description=Qacey Offsite Backup Verification
Documentation=https://github.com/buhagee/agentic-homelab
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash __PLATFORM_DIR__/scripts/maintenance/verify-backup.sh
User=root
StandardOutput=journal
StandardError=journal
