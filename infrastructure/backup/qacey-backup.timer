[Unit]
Description=Qacey Platform Backup Timer (Nightly at 02:00 AEST)
Documentation=https://github.com/qacey/qacey-platform

[Timer]
# Run nightly at 16:00 UTC = 02:00 AEST (03:00 AEDT during daylight saving).
OnCalendar=*-*-* 16:00:00
# If system was off at scheduled time, run on next boot
Persistent=true

[Install]
WantedBy=timers.target
