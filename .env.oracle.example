# Oracle VPS environment variables
# Copy to .env.oracle and fill in values before running oracle-deploy.sh

# Oracle VPS public IP address
ORACLE_IP=
QACEY_DOMAIN=example.com
HOME_LAN_CIDR=192.168.0.0/16

# Let's Encrypt account email (used for cert expiry notices)
ACME_EMAIL=your@email.com

# Cloudflare API token for DNS-01 wildcard cert (*.example.com)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone → DNS → Edit  (scoped to example.com zone only)
CF_DNS_API_TOKEN=

# Email alerts for backup and CrowdSec (Google Workspace app password).
# Public values can live here; SMTP_PASSWORD belongs in .env.oracle only.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_ENCRYPTION=starttls
# SMTP_PASSWORD belongs in .env.oracle only (not committed).

# ── CrowdSec ────────────────────────────────────────────────────────────────
# API key for the Traefik bouncer — auto-registered by oracle-deploy.sh.
# Do NOT set manually; oracle-deploy.sh generates and writes this.
CROWDSEC_ORACLE_LAPI_KEY=
# crowdsec-oracle's oracle_net IP — auto-detected by oracle-deploy.sh.
# The bouncer (in wireguard's network namespace) uses this to reach the LAPI.
CROWDSEC_ORACLE_NET_IP=

# ── U-11: WireGuard keys (generated by oracle-deploy.sh) ───────────────────
# WIREGUARD_ORACLE_PRIVATE_KEY / PUBLIC_KEY: auto-generated by oracle-deploy.sh on first run.
# Do NOT fill these in manually — let oracle-deploy.sh generate them.
# WIREGUARD_HOME_PUBLIC_KEY: copy from the home server .env after running first-time-setup.sh
WIREGUARD_ORACLE_PRIVATE_KEY=
WIREGUARD_ORACLE_PUBLIC_KEY=
# Home server public key — needed so Oracle WireGuard knows the home peer
# Copy from WIREGUARD_HOME_PUBLIC_KEY in the home server .env
WIREGUARD_HOME_PUBLIC_KEY=
