# ============================================================================
# qacey-platform — Environment Variables
# ============================================================================
# Copy to .env and fill in values before running first-time-setup.sh.
# ============================================================================

# ── Paths ─────────────────────────────────────────────────────────────────
# Absolute path to this repo on the server
PLATFORM_DIR=/srv/agentic-homelab
# Host docker group ID used only by the restricted OpenCode service controller.
DOCKER_GID=983

# ── Domain & Routing ──────────────────────────────────────────────────────
QACEY_DOMAIN=example.com                   # prod: example.com | dev: dev.example.com
CERT_RESOLVER=cloudflare                    # prod: cloudflare | dev: letsencrypt
ACME_EMAIL=CHANGE_ME_EMAIL                  # Let's Encrypt / Cloudflare expiry notices

# ── Server IPs ────────────────────────────────────────────────────────────────
# Home server LAN IP — used for AdGuard DNS binding and WireGuard UFW rules
HOME_SERVER_IP=192.0.2.10
# Oracle VPS public IP — used for WireGuard endpoint and UFW rules
ORACLE_IP=203.0.113.10
# Fixed Docker IP for Traefik on qacey-proxy network — used by wireguard-home DNAT rules
# Must be within 172.18.0.0/16 and not conflict with other containers
TRAEFIK_PROXY_IP=172.18.255.250

# ── Cloudflare (prod) ─────────────────────────────────────────────────────
# Tunnel token: Zero Trust dashboard → Networks → Tunnels → Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# DNS API token: dash.cloudflare.com/profile/api-tokens → Edit zone DNS → example.com
CF_DNS_API_TOKEN=

# ── deSEC (dev only) ──────────────────────────────────────────────────────
# Token: desec.io/tokens
DESEC_TOKEN=

# ── Admin credentials ─────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD     # min 8 chars, 1 upper, 1 lower, 1 digit/special

# ── Google OAuth (shared across all services) ─────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Application type: Web application
# Redirect URIs to register:
#   https://photos.DOMAIN/auth/login                          (Immich)
#   https://photos.DOMAIN/api/oauth/mobile-redirect           (Immich iOS)
#   https://vault.DOMAIN/identity/connect/oidc-signin         (Vaultwarden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                         # private; put in secrets/.env

# ── U-02: Immich ──────────────────────────────────────────────────────────
IMMICH_DB_PASSWORD=                        # generated: openssl rand -hex 24
# API key for setup-oauth.sh re-runs (when password login is disabled).
# Generate at: https://photos.DOMAIN → Account Settings → API Keys
IMMICH_API_KEY=

# ── U-15: Bulk upload for mum's account ──────────────────────────────────
# API key for user@example.com — used by immich-bulk-upload.sh
# Generate at: https://photos.DOMAIN → Account Settings → API Keys (while logged in as mum)

# ── U-02: Vaultwarden ─────────────────────────────────────────────────────
# Generate bcrypt hash: echo -n "your-password" | htpasswd -inBC 10 "" | tr -d ':\n'
VAULTWARDEN_ADMIN_TOKEN=
# Set to true once GOOGLE_CLIENT_ID/SECRET are filled in — Vaultwarden v1.36+ requires
# all three SSO vars set when SSO_ENABLED=true
VAULTWARDEN_SSO_ENABLED=false

# ── U-02: SearXNG ─────────────────────────────────────────────────────────
SEARXNG_SECRET_KEY=                        # generated: openssl rand -hex 32

# Intervals.icu API key (Justin only)
# Get at: intervals.icu → Settings → API → API Key
INTERVALS_API_KEY_JUSTIN=
# Get at: intervals.icu → URL when logged in (e.g. intervals.icu/athlete/i512469)
INTERVALS_ATHLETE_ID_JUSTIN=

# ── MCP integrations ─────────────────────────────────────────────────────
# Crawl4AI is self-hosted (unclecode/crawl4ai container).
# CRAWL4AI_API_TOKEN is generated by first-time-setup.sh and stored in secrets/.env.
# Without it the Crawl4AI API binds to loopback and the MCP bridge cannot reach it.
# paper-search-mcp: searches 20+ academic sources (arXiv, PubMed, Semantic Scholar, etc.)
# Unpaywall email is required to enable DOI-based OA lookups (free — any valid email)
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
# Free API keys that improve rate limits (optional but recommended):
#   CORE:             https://core.ac.uk/services/api
#   Semantic Scholar: https://www.semanticscholar.org/product/api
#   DOAJ:             https://doaj.org/api/docs
#   Zenodo:           https://zenodo.org/account/settings/applications
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=
PAPER_SEARCH_MCP_DOAJ_API_KEY=
PAPER_SEARCH_MCP_ZENODO_ACCESS_TOKEN=
# Google Scholar proxy URL (optional — bypasses bot detection):
PAPER_SEARCH_MCP_GOOGLE_SCHOLAR_PROXY_URL=

# ── U-04: Hermes Agent ────────────────────────────────────────────────────

# Hermes service account — UID and GID of the 'hermes' system user on the host
# Populated automatically by first-time-setup.sh
HERMES_UID=
HERMES_GID=

# LLM Provider API Keys
# OpenCode Go API key — Hermes main text path when using the OpenCode Go provider
# Get a key at: https://opencode.ai/auth
OPENCODE_GO_API_KEY=
# OpenCode Go OpenAI-compatible relay. SkillClaw uses this same endpoint.
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# OpenCode V2 app/server password (generated into secrets/.env by first-time setup).
OPENCODE_PASSWORD=

# OpenRouter API key — aggregator for multiple models
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hermes default routing — OpenCode Go for main text and SkillClaw; OpenRouter
# retained for vision and image generation.
HERMES_PROVIDER=opencode-go
HERMES_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL=openai/gpt-5.6-luna
HERMES_MODEL_FALLBACK=openai/gpt-5.6-luna
HERMES_FALLBACK_PROVIDER=opencode-go
HERMES_FALLBACK_BASE_URL=
HERMES_FALLBACK_KEY_ENV=
HERMES_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HERMES_REASONING_EFFORT=high
HERMES_IMAGE_INPUT_MODE=text
HERMES_VISION_MODEL=google/gemini-2.5-flash
# Hermes image_generate tool through OpenRouter. The model must support
# text+image -> text+image output; this model uses the existing OpenRouter key.
HERMES_IMAGE_GEN_MODEL=google/gemini-2.5-flash-image
HERMES_IMAGE_GEN_MAX_PARALLEL_REQUESTS=4
# SkillClaw nightly skill-evolution model, served by the OpenCode Go relay.
SKILLCLAW_MODEL=deepseek-v4-flash

# Email alerts for backup, CrowdSec and the host healthcheck.
# Google Workspace app password; the password itself lives only in secrets/.env.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_ENCRYPTION=starttls

# Hermes HTTP API keys for Siri Shortcuts — one per user
# Generate: openssl rand -hex 32
HERMES_API_KEY_JUSTIN=
HERMES_API_KEY_ANNIQUE=

# ── Hermes WebUI (agent-annique.example.com) ───────────────────────────────
# ghcr.io/nesquena/hermes-webui. Justin's webui was retired in favor of the
# direct dashboard below; Annique's stays available in parallel. Hermex (iOS)
# connects with the subdomain URL + password. Real value only in secrets/.env.
HERMES_WEBUI_PASSWORD_ANNIQUE=

# ── Hermes direct dashboard (hermes.example.com / hermes-annique.example.com) ──
# Hermex 2.0 connects directly to each agent's built-in dashboard instead of
# the webui (needed for "Move to Hermes" and session edits, Hermes >= 0.22.3).
# Passed through to the dashboard's basic-auth plugin
# (HERMES_DASHBOARD_BASIC_AUTH_USERNAME/_PASSWORD); it refuses a public bind
# without them. Generate: openssl rand -hex 32. Real values only in secrets/.env.
HERMES_DASHBOARD_USERNAME_JUSTIN=justin
HERMES_DASHBOARD_PASSWORD_JUSTIN=
HERMES_DASHBOARD_USERNAME_ANNIQUE=annique
HERMES_DASHBOARD_PASSWORD_ANNIQUE=

# Optional temporary sandbox. Start with scripts/sandbox/start.sh.
# Google OAuth uses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET plus the shared email
# allowlist at secrets/browser-oauth-allowed-emails.txt.
# Register https://sandbox.${QACEY_DOMAIN}/oauth2/callback in Google Cloud Console.
SANDBOX_OAUTH2_COOKIE_SECRET=
SANDBOX_WORKSPACE_DIR=/mnt/ssd/qacey/hermes/justin/data/sandbox

# ── U-06: mnemo-hermes (semantic memory) ──────────────────────────────────────
# PostgreSQL password for mnemo-postgres (pgvector). Databases: mnemo_justin, mnemo_annique
# Generate: openssl rand -hex 24
MNEMO_POSTGRES_PASSWORD=

## U-08: Additional MCPs + Home Assistant ─────────────────────────────────────

# Home Assistant long-lived access token
# Create after first HA boot: Profile → Security → Long-lived access tokens
HA_LONG_LIVED_TOKEN=

# Google Workspace OAuth for repo-managed Gmail, Drive, Docs, and Sheets MCP
# Create an OAuth client with Gmail API, Google Drive API, Google Docs API, and
# Google Sheets API enabled. The Gmail scopes are gmail.readonly + gmail.send.
# The repo-managed deploy step writes a per-user authorized-user JSON file under each agent's
# data dir using the shared client id/secret plus the user's refresh token.
# Keep the client id/secret shared and the refresh tokens per-user; do not add
# the rendered auth JSON files to source control.
# Justin-first rollout is explicit: if the shared client material or Justin's refresh token is
# missing, deploy-agent-config.sh omits Justin's google_workspace MCP and leaves auth absent
# instead of pretending the capability is enabled.
# After changing scopes, reauthorize the refresh token; see secrets/README.md.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN_JUSTIN=
GOOGLE_WORKSPACE_REFRESH_TOKEN_ANNIQUE=   # optional until Annique rollout is enabled

# ── U-10: CrowdSec ─────────────────────────────────────────────────────────
# CrowdSec bouncer API key (auto-generated by first-time-setup.sh)
CROWDSEC_LAPI_KEY=
# CrowdSec cloud enrollment token — get from app.crowdsec.net → Security Engines → Add
# first-time-setup.sh will enroll automatically if set; safe to leave empty
CROWDSEC_ENROLLMENT_TOKEN=

# ── U-11: WireGuard tunnel (Oracle VPS ↔ home server) ──────────────────────
# Home server keys — generated once by: wg genkey | tee private.key | wg pubkey
# Or let first-time-setup.sh generate them automatically.
# Private key (keep secret — never commit to git)
WIREGUARD_HOME_PRIVATE_KEY=
# Public key (safe to share — goes into Oracle's .env.oracle as WIREGUARD_HOME_PUBLIC_KEY)
WIREGUARD_HOME_PUBLIC_KEY=
# Oracle VPS public key — copy from WIREGUARD_ORACLE_PUBLIC_KEY in Oracle's .env.oracle
# (auto-populated by oracle-deploy.sh on first run)
WIREGUARD_ORACLE_PUBLIC_KEY=

# ── U-14: Backup — Backblaze B2 (optional — skip if not set) ─────────────────
# If all four vars are set, backup.sh will run a nightly restic → B2 offsite backup.
# Leave blank to run local mirror only (Phase 1 always runs regardless).
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
B2_BUCKET=
RESTIC_PASSWORD=

# ── Paperless-ngx (optional) ───────────────────────────────────────────────
# If you deploy Paperless-ngx, set these values. The MCP server uses
# `PAPERLESS_API_TOKEN` to authenticate against the Paperless REST API.
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_API_TOKEN=
